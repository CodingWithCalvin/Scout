oIcon}" Stroke="#78B8FF" Margin="0,0,10,0"/><TextBlock x:Name="ReviewCount" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="#F0C581" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Unresolved" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></StackPanel></Border></UniformGrid>

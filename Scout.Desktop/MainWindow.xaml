<ListBox.ItemTemplate><DataTemplate><StackPanel ToolTip="{Binding Library}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" FontSize="11" Foreground="#9AADC5" Margin="0,6,0,0"/><TextBlock Text="{Binding Label}" FontSize="10" Foreground="#7E91AB" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Row="2"><Border BorderBrush="#2B3C51" BorderThickness="0,1,0,0" Margin="0,14,0,14"/><Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource SettingsIcon}" Margin="0,0,12,0"/><TextBlock Text="Settings"/></StackPanel></Button><TextBlock Text="0.9.12" Foreground="#7E91AB" FontSize="10" Margin="14,8,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1" Margin="24,16,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel x:Name="ScoutHeader" Margin="0,0,0,12">
<Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,16,0"><TextBlock x:Name="WorkspaceHeading" Text="Choose a source folder" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceSource" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>

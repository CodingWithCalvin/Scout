</StackPanel></ScrollViewer></TabItem>

<TabItem Style="{StaticResource OutlinedTab}" ><TabItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource LinkIcon}" Margin="0,0,10,0"/><TextBlock Text="Connection"/></StackPanel></TabItem.Header><ScrollViewer Foreground="#F0F4FA" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Matching provider"/><ComboBox x:Name="ProviderChoice" SelectedIndex="0" SelectionChanged="ProviderChanged" Margin="0,8,0,20"><ComboBoxItem Content="Connect to a model server (IP/URL)"/><ComboBoxItem Content="Let Scout Launch my Model"/><ComboBoxItem Content="OpenAI · Responses API"/></ComboBox>
<StackPanel x:Name="LocalConnectionPanel"><TextBlock Text="Local model"/><ComboBox x:Name="ModelId" IsEditable="True" IsTextSearchEnabled="False" DisplayMemberPath="Name" DropDownOpened="LocalModelsOpened" SelectionChanged="LocalModelSelected" Margin="0,8,0,8"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></ComboBox.ItemContainerStyle></ComboBox><TextBlock x:Name="LocalModelsHint" Text="Choose a downloaded GGUF model, or enter the model ID for an existing endpoint." Style="{StaticResource Subtitle}"/><TextBox x:Name="Endpoint" Visibility="Collapsed" Text="http://127.0.0.1:18765/v1/chat/completions"/><TextBlock x:Name="LocalModeHelp" Style="{StaticResource Subtitle}"/></StackPanel>
<StackPanel x:Name="OpenAiPanel" Visibility="Collapsed"><TextBlock Text="OpenAI model ID"/><TextBox x:Name="OpenAiModelEntry"/><TextBlock Text="Endpoint: https://api.openai.com/v1/responses" Style="{StaticResource Subtitle}"/><TextBlock Text="API key · leave blank to retain the saved key"/><PasswordBox x:Name="OpenAiKeyEntry" Padding="12,9" Margin="0,8,0,8"/><TextBlock x:Name="OpenAiKeyStatus" Foreground="{StaticResource MutedBrush}"/><Button Content="Remove saved OpenAI key" Click="RemoveOpenAiKey" HorizontalAlignment="Left" Margin="0,12,0,20"/></StackPanel>
<StackPanel x:Name="CompatiblePanel" Visibility="Collapsed"><TextBlock Text="Server URL · complete Chat Completions endpoint"/><TextBox x:Name="CompatibleEndpointEntry" TextChanged="ServerEndpointChanged"/><TextBlock Text="Model ID"/><TextBox x:Name="CompatibleModelEntry"/><TextBlock Text="Remote server API key · stored separately for this endpoint"/><PasswordBox x:Name="CompatibleKeyEntry" Padding="12,9" Margin="0,8,0,8"/><TextBlock x:Name="CompatibleKeyStatus" Foreground="{StaticResource MutedBrush}"/><Button Content="Remove key for this endpoint" Click="RemoveCompatibleKey" HorizontalAlignment="Left" Margin="0,12,0,20"/><TextBlock Text="Connects to an already-running server. Localhost accepts HTTP; remote servers use HTTPS, a saved API key and dialogue permission. The server must support strict JSON-schema Chat Completions." Style="{StaticResource Subtitle}"/></StackPanel>
<StackPanel x:Name="CloudPrivacyPanel" Visibility="Collapsed"><CheckBox x:Name="CloudConsent" Content="Allow full dialogue and episode-guide text to be sent to the selected cloud provider" Margin="0,12,0,12"/>
<TextBlock Text="Video files stay local. API use can incur charges. No automatic switch from local to cloud. Saved keys are encrypted for your Windows account and never included in reports or source packages." Style="{StaticResource Subtitle}"/></StackPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem Style="{StaticResource OutlinedTab}" ><TabItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource ModelIcon}" Margin="0,0,10,0"/><TextBlock Text="Local models"/></StackPanel></TabItem.Header><ScrollViewer Foreground="#F0F4FA" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Model storage folder"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Click="BrowseModelFolder" Margin="10,5,0,14"/><TextBox x:Name="ModelFolderEntry" TextChanged="RuntimeLocationChanged"/></DockPanel>
<TextBlock Text="GGUF model to use"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Click="BrowseModelFile" Margin="10,5,0,14"/><TextBox x:Name="ModelFileEntry"/></DockPanel>
<TextBlock Text="Managed llama-server · b11908" FontWeight="SemiBold"/><TextBlock Text="Installed automatically for managed runs. CPU build with 0 GPU layers; Vulkan build otherwise (requires a compatible graphics driver). Includes all runtime libraries. Custom GGUF compatibility is not guaranteed." Style="{StaticResource Subtitle}"/>
<TextBlock x:Name="ManagedRuntimeStatus" Text="Checking managed runtime…" Foreground="#BBD8FF" TextWrapping="Wrap" Margin="0,4,0,8"/>
<TextBlock Text="Installed managed runtime path"/><TextBox x:Name="ManagedRuntimePath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Installed managed runtime path"/>
<TextBlock x:Name="ManagedRuntimeUsage" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
<Button Content="Download / verify runtime" Click="DownloadRuntime" HorizontalAlignment="Left"/>
<UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="CPU threads"/><TextBox x:Name="ThreadsEntry"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="GPU layers · 0 = CPU"/><TextBox x:Name="GpuEntry" TextChanged="RuntimeLocationChanged"/></StackPanel><StackPanel><TextBlock Text="Context tokens"/><TextBox x:Name="ContextEntry"/></StackPanel></UniformGrid>
<CheckBox x:Name="AllowDownloadsEntry" Content="Allow model and runtime downloads" Margin="0,6,0,10"/><CheckBox x:Name="AutoDownloadEntry" Content="Download the selected profile when missing, at the start of a managed run" Margin="0,0,0,10"/><CheckBox x:Name="ExperimentalEntry" Content="Allow experimental model profiles" Margin="0,0,0,16"/>
<TextBlock Text="Pinned download profile"/><ComboBox x:Name="DownloadProfileChoice" SelectionChanged="RuntimeProfileChanged" DisplayMemberPath="Display" Margin="0,8,0,12"/><TextBlock Text="Qwen3.6 is experimental, not a general recommendation. The download is about 22.1 GB. Downloads are checked against the pinned size and SHA256; existing unverified files are never overwritten." Style="{StaticResource Subtitle}"/>
<Button x:Name="DownloadButton" Click="DownloadModel" HorizontalAlignment="Left" AutomationProperties.Name="Download / verify model and runtime"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource DownloadIcon}" Margin="0,0,10,0"/><TextBlock Text="Download / verify model and runtime"/></StackPanel></Button>
</StackPanel></ScrollViewer></TabItem>
<TabItem Style="{StaticResource OutlinedTab}" ><TabItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource ChartIcon}" Margin="0,0,10,0"/><TextBlock Text="Usage and tools"/></StackPanel></TabItem.Header><ScrollViewer Foreground="#F0F4FA" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<UniformGrid Columns="3"><StackPanel Margin="0,0,12,0"><TextBlock Text="Max output tokens / request"/><TextBox x:Name="OutputTokensEntry"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Request timeout (seconds)"/><TextBox x:Name="TimeoutEntry"/></StackPanel><StackPanel><TextBlock Text="Requests per run"/><TextBox x:Name="RequestsEntry"/></StackPanel></UniformGrid>
<TextBlock Text="Matching normally makes two requests per uncached recording. The cap stops new requests; it is not a dollar budget. Cancelling a cloud request may not prevent provider charges. Processing is sequential." Style="{StaticResource Subtitle}"/>
<TextBlock Text="FFmpeg executable or command"/><TextBox x:Name="FfmpegEntry"/><TextBlock Text="FFprobe executable or command"/><TextBox x:Name="FfprobeEntry"/>
<Border Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel><TextBlock Text="Latest run usage" FontWeight="SemiBold"/><TextBlock x:Name="UsageText" Text="No requests made in this session." TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
<StackPanel Margin="0,18,0,18"><TextBlock Text="Advanced run data" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock x:Name="GuideStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><WrapPanel><Button Content="Replace saved episode guide" Click="BrowseCatalog"/><Button Content="Use saved dialogue" Click="BrowseDialogue"/></WrapPanel><TextBlock Text="Optional overrides for the selected run. Scout reads dialogue from the videos by default." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/></StackPanel>
<TextBlock Text="Provider-reported input/output tokens are saved in usage.json beside the results. Missing provider usage is not a verified zero-cost run." Style="{StaticResource Subtitle}"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Show discovery" Style="{StaticResource OutlinedTab}"><ScrollViewer Foreground="#F0F4FA" FontWeight="Normal" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
<TextBlock Text="Metadata provider credentials" FontSize="20" FontWeight="SemiBold"/>
<TextBlock Text="Select a provider in the Scout's Overview and setup. TVDB and TMDB require your provider credentials; TVmaze needs no key. Leave fields blank to retain saved credentials. Keys are encrypted for this Windows account." Style="{StaticResource Subtitle}"/>
<TextBlock Text="TheTVDB API key"/><PasswordBox x:Name="TvdbKeyEntry" Padding="12,9" Margin="0,8,0,4"/><TextBlock x:Name="TvdbKeyStatus" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
<TextBlock Text="TheTVDB subscriber PIN · only for user-supported keys"/><PasswordBox x:Name="TvdbPinEntry" Padding="12,9" Margin="0,8,0,4"/><TextBlock x:Name="TvdbPinStatus" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
<TextBlock Text="TMDB API Read Access Token (Bearer token)"/><PasswordBox x:Name="TmdbTokenEntry" Padding="12,9" Margin="0,8,0,4"/><TextBlock x:Name="TmdbTokenStatus" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>
<TextBlock Text="Saved credential fields stay empty. Configured means stored on this computer; a successful provider lookup verifies access." Style="{StaticResource Subtitle}"/>
<Button Content="Remove saved metadata credentials" Click="RemoveMetadataKeys" HorizontalAlignment="Left"/>
<TextBlock Text="Known show: look up its title or ID, select it, and match filenames without a model. Unknown show: choose how many files to inspect and optionally enable dialogue fallback. Each provider uses its own episode numbering; imported guides remain independent snapshots." Style="{StaticResource Subtitle}"/>
<TextBlock Text="Provider access and distribution terms apply. TheTVDB: thetvdb.com · TMDB: themoviedb.org · TVmaze: tvmaze.com/api" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl>
<DockPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="SettingsCancelButton" Content="Cancel download" Click="CancelSettingsDownload" DockPanel.Dock="Right" Visibility="Collapsed"/><Button Style="{StaticResource Primary}" Click="SaveSettings" DockPanel.Dock="Right" AutomationProperties.Name="Save settings"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource LineIcon}" Data="{StaticResource SaveIcon}" Margin="0,0,10,0"/><TextBlock Text="Save settings"/></StackPanel></Button><TextBlock x:Name="SettingsStatus" Text="Local by default. Downloads and cloud processing start disabled." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
</Grid>
<Border Grid.Row="2" BorderBrush="#283345" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,8,0,0"><DockPanel><TextBlock Text="PREVIEW ONLY" Foreground="{StaticResource AccentBrush}" FontSize="11" DockPanel.Dock="Right"/><Button x:Name="UndoDeleteButton" DockPanel.Dock="Right" Content="Undo delete" Click="UndoDelete" Visibility="Collapsed" Padding="8,2" Margin="8,0"/><TextBlock x:Name="Status" Text="Ready" Foreground="{StaticResource MutedBrush}" FontSize="12"/></DockPanel></Border>
</Grid></Grid></Grid></Window>
